      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC02: ontbrekende gebruikersheader geeft 400', () => pm.response.to.have.status(400));"
            ]
          }
