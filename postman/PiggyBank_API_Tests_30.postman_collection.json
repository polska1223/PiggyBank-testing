        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderAccountId\": 1,\n  \"receiverAccountId\": 2,\n  \"description\": \"TC09 geldig\",\n  \"amount\": 10,\n  \"currency\": \"EURO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
