    {
      "name": "TC04 - Negatief gebruikersnummer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "-1"
          }
        ],
        "url": "{{baseUrl}}/api/v1/accounts",
        "description": "X-User-Id -1. In AccountController wordt het ID als long gelezen en de rekeninglijst opgehaald, zonder check op negatieve waarden. De huidige API geeft daarom 200 met accounts: []. Dat is hier de verwachte bestaande werking; een 400 bij negatieve IDs is een mogelijk verbeterpunt, geen bevestigde eis."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC04: onbekende gebruiker geeft 200 volgens huidige API', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('TC04: negatieve ID levert geen rekeninggegevens op', () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.accounts).to.be.an('array').that.is.empty;",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
